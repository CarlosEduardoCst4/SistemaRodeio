@model SistemaRodeio.Models.DashboardViewModel
@{
    ViewData["Title"] = "Painel";
}

<div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1">PAINEL DO RODEIO</h2>
        <p class="text-muted mb-0">Visão geral dos dados cadastrados no sistema.</p>
    </div>
    <span class="text-muted small">Atualizado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
</div>

@* ===== Cards de resumo ===== *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background-color:#f4e7d0;">
                    <i class="bi bi-clipboard-data-fill text-primary fs-4"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalAnimais</div>
                    <div class="text-muted small">Animais</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background-color:#f4e7d0;">
                    <i class="bi bi-tags-fill text-warning fs-4"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalTiposAnimais</div>
                    <div class="text-muted small">Tipos de Animal</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background-color:#f4e7d0;">
                    <i class="bi bi-people-fill text-success fs-4"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalCompetidores</div>
                    <div class="text-muted small">Competidores</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background-color:#f4e7d0;">
                    <i class="bi bi-geo-alt-fill text-danger fs-4"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalCidades</div>
                    <div class="text-muted small">Cidades</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     style="width:48px;height:48px;background-color:#f4e7d0;">
                    <i class="bi bi-flag-fill" style="color:#010eff;" ></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalRounds</div>
                    <div class="text-muted small">Rounds</div>
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    @* ===== Top competidores ===== *@
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-trophy-fill me-2 text-warning"></i>Top Competidores</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.TopCompetidores.Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Nome</th>
                                <th>Cidade</th>
                                <th class="text-end">Vitórias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int posicao = 1; }
                            @foreach (var c in Model.TopCompetidores)
                            {
                                <tr>
                                    <td>
                                        @if (posicao == 1)
                                        {
                                            <i class="bi bi-trophy-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            @posicao
                                        }
                                    </td>
                                    <td>@c.nome</td>
                                    <td>@(c.cidade?.descricao ?? "-")</td>
                                    <td class="text-end fw-bold">@c.vitorias</td>
                                </tr>
                                posicao++;
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">Nenhum competidor cadastrado ainda.</p>
                }
            </div>
        </div>
    </div>
</div>

@* ===== Últimos rounds ===== *@
<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history me-2" style="color:rgb(4, 3, 1);"></i>Últimos Rounds Cadastrados</h5>
                <a asp-controller="Round" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todos</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UltimosRounds.Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Competidor</th>
                                <th>Animal</th>
                                <th class="text-end">Nota Animal</th>
                                <th class="text-end">Nota Competidor</th>
                                <th class="text-end">Penalidade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.UltimosRounds)
                            {
                                <tr>
                                    <td>@r.data.ToString("dd/MM/yyyy")</td>
                                    <td>@(r.competidor?.nome ?? "-")</td>
                                    <td>@(r.animal?.nome ?? "-")</td>
                                    <td class="text-end">@r.notAnimal</td>
                                    <td class="text-end">@r.notCompetidor</td>
                                    <td class="text-end">@r.penalidade</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted p-3 mb-0">Nenhum round cadastrado ainda.</p>
                }
            </div>
        </div>
    </div>
</div>
</div>