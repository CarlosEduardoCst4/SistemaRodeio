@{
    ViewData["Title"] = "Sobre";
}

<div class="p-4 p-md-5 rounded-4 mb-4 text-center"
     style="background: linear-gradient(135deg, var(--cor-footer), var(--cor-header));">
    <i class="bi bi-flag-fill fs-1" style="color:#1e293b;"></i>
    <h1 class="fw-bold mt-2" style="color:#1e293b;">Sistema Rodeio</h1>
    <p class="lead mb-0" style="color:#1e293b;">
        Gestão completa de animais, competidores, cidades e rounds de competição.
    </p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold"><i class="bi bi-info-circle-fill text-primary me-2"></i>O que é o sistema?</h5>
                <p class="text-muted mb-0">
                    O <strong>Sistema Rodeio</strong> foi criado para organizar o dia a dia de um rodeio:
                    cadastro de animais e seus tipos, competidores e suas cidades, além do registro de cada
                    round disputado, com notas do animal, do competidor e eventuais penalidades. A ideia é
                    reunir tudo em um só lugar, de forma simples e visual.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <h5 class="fw-bold"><i class="bi bi-gear-fill text-primary me-2"></i>Tecnologias utilizadas</h5>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge rounded-pill text-bg-primary">ASP.NET Core MVC</span>
                    <span class="badge rounded-pill text-bg-secondary">Entity Framework Core</span>
                    <span class="badge rounded-pill text-bg-dark">SQL Server</span>
                    <span class="badge rounded-pill" style="background-color:#7c3aed;color:#fff;">C#</span>
                    <span class="badge rounded-pill text-bg-info">Bootstrap 5</span>
                    <span class="badge rounded-pill text-bg-success">Bootstrap Icons</span>
                </div>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold mb-3"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Módulos do sistema</h5>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-clipboard-data-fill fs-2 text-primary"></i>
                <h6 class="fw-bold mt-2 mb-0">Animal</h6>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-tags-fill fs-2 text-warning"></i>
                <h6 class="fw-bold mt-2 mb-0">Tipo de Animal</h6>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-geo-alt-fill fs-2 text-danger"></i>
                <h6 class="fw-bold mt-2 mb-0">Cidade</h6>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-people-fill fs-2 text-success"></i>
                <h6 class="fw-bold mt-2 mb-0">Competidor</h6>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg">
        <div class="card border-0 shadow-sm text-center h-100">
            <div class="card-body">
                <i class="bi bi-flag-fill fs-2" style="color:#7c3aed;"></i>
                <h6 class="fw-bold mt-2 mb-0">Round</h6>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-4">
        <i class="bi bi-code-slash fs-3 text-muted"></i>
        <p class="mb-0 mt-2 text-muted">
            Desenvolvido em ASP.NET Core MVC + Bootstrap.
        </p>
    </div>
</div>
