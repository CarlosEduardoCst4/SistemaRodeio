@model SistemaRodeio.Models.Round

@{
    ViewData["Title"] = "Edit";
}

<h2 class="fw-bold text-primary mb-0">EDITAR ROUND</h2>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="id" />
            <div class="form-group">
                <label asp-for="competidorid" class="control-label"></label>
                <select asp-for="competidorid" class="form-control" asp-items="ViewBag.competidorid"></select>
                <span asp-validation-for="competidorid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="animalid" class="control-label"></label>
                <select asp-for="animalid" class="form-control" asp-items="ViewBag.animalid"></select>
                <span asp-validation-for="animalid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="data" class="control-label"></label>
                <input asp-for="data" class="form-control" />
                <span asp-validation-for="data" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="notAnimal" class="control-label"></label>
                <input asp-for="notAnimal" class="form-control" />
                <span asp-validation-for="notAnimal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="notCompetidor" class="control-label"></label>
                <input asp-for="notCompetidor" class="form-control" />
                <span asp-validation-for="notCompetidor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="penalidade" class="control-label"></label>
                <input asp-for="penalidade" class="form-control" />
                <span asp-validation-for="penalidade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">
    <i class="bi bi-arrow-left"></i> VOLTAR </a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
