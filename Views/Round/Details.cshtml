</div>
    <a asp-action="Edit" asp-route-id="@Model?.id" class="btn btn-primary">
    <i class="bi bi-pencil-fill"></i> Editar </a>  <a asp-action="Index" class="btn btn-secondary">
    <i class="bi bi-arrow-left"></i> VOLTAR </a>
</div>
