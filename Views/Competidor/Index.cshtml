@model IEnumerable<SistemaRodeio.Models.Competidor>

@{
    ViewData["Title"] = "Index";
}

<h2 class="fw-bold text-primary mb-0">COMPETIDOR</h2>

<p>
    <a asp-action="Create">Criar Competidor</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.cidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.vitorias)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.cidade.descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.idade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.vitorias)
            </td>
            <td class="text-center" style="width: 160px;">
                <a href="@Url.Action("Edit", "Competidor", new { id = item.id })"
                class="btn btn-sm btn-outline-primary me-1"
                title="Editar">
                <i class="bi bi-pencil-fill"></i>
                </a>
                <a href="@Url.Action("Details", "Competidor", new { id = item.id })"
                class="btn btn-sm btn-outline-info me-1"
                title="Detalhes">
                <i class="bi bi-eye-fill"></i>
                </a>
                <a href="@Url.Action("Delete", "Competidor", new { id = item.id })"
                class="btn btn-sm btn-outline-danger"
                title="Excluir">
                <i class="bi bi-trash-fill"></i>
                </a>
            </td>
        </tr>
}
    </tbody>
</table>
